name "tgc"
description "Opt-in thread-local garbage collector for D - per-thread heaps without global stop-the-world"
authors "amdphreak"
copyright "Copyright (c) 2026, dlang-supplemental contributors"
license "BSL-1.0"
version "0.1.1"

importPaths "source"

configuration "library" {
    targetType "library"
    targetName "tgc"
    sourcePaths "source"
}

configuration "unittest" {
    targetType "library"
    sourcePaths "source" "test"
    versions "Tgc_default"
}

// A GC must be correct under optimization: pointers move into registers, dead
// stores vanish, and stack slots are reused. The default unittest build is
// unoptimized and hides all of that.
buildType "unittest-optimized" {
    buildOptions "unittests" "optimize" "inline" "debugInfo"
}

// Sanitizer builds (LDC only). `dub test --dflags=...` is not a thing, so the
// flags live here where they can be checked in.
//
// TgcSanitize scales the test suites' iteration counts down: sanitizers
// instrument every load, and a conservative collector scanning whole stacks is
// close to their worst case.
buildType "unittest-tsan" {
    buildOptions "unittests" "debugInfo"
    dflags "-fsanitize=thread"
    // TgcTSan gates the __tsan_* happens-before annotations, which only exist
    // when linking against the thread sanitizer runtime.
    versions "TgcSanitize" "TgcTSan"
}

buildType "unittest-asan" {
    buildOptions "unittests" "debugInfo"
    dflags "-fsanitize=address"
    versions "TgcSanitize"
}

// Benchmarks. The mark phase is the collector's largest cost, so a change to it
// has to be measured rather than reasoned about; `bench/run.sh` drives these.
//
// Each is a normal executable with tgc linked in, so the collector is chosen at
// runtime with `--DRT-gcopt=gc:` and both columns of a comparison run the same
// binary.
configuration "bench-bintree" {
    targetType "executable"
    targetName "bench-bintree"
    sourcePaths "source"
    sourceFiles "bintree.d"
    mainSourceFile "bintree.d"
}

configuration "bench-mt" {
    targetType "executable"
    targetName "bench-mt"
    sourcePaths "source"
    sourceFiles "bintree_mt.d"
    mainSourceFile "bintree_mt.d"
}

configuration "bench-region" {
    targetType "executable"
    targetName "bench-region"
    sourcePaths "source"
    sourceFiles "bintree_region.d"
    mainSourceFile "bintree_region.d"
}

// The probes behind WEBSERVER.md: collection time against live set, and
// against suspended fibers.
configuration "bench-webserver" {
    targetType "executable"
    targetName "bench-webserver"
    sourcePaths "source"
    sourceFiles "bench/webserver_probe.d"
    mainSourceFile "bench/webserver_probe.d"
}

// Does a shrunken heap give its memory back, and what does GC.reserve buy?
configuration "bench-trim" {
    targetType "executable"
    targetName "bench-trim"
    sourcePaths "source"
    sourceFiles "bench/trim_probe.d"
    mainSourceFile "bench/trim_probe.d"
}

// The CI regression gate; driven by bench/gate.sh.
configuration "bench-gate" {
    targetType "executable"
    targetName "bench-gate"
    sourcePaths "source"
    sourceFiles "bench/gate.d"
    mainSourceFile "bench/gate.d"
}
